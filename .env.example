# ---------------------------------------------------------------- Firebase (client)
# Firebase console -> Project settings -> General -> Your apps -> Web app -> SDK setup
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# ----------------------------------------------------------- Firebase Admin (server)
# Firebase console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_CLIENT_EMAIL=
# Keep the \n escapes and wrap the whole key in double quotes
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"

# -------------------------------------------------------------------- Cloudinary
# Cloudinary dashboard -> Product Environment Credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -------------------------------------------------- Seed script (npm run seed) only
# Email of the account that should be promoted to admin when seeding
SEED_ADMIN_EMAIL=
